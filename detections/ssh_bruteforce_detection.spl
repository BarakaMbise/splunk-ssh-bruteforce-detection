
index=soc_lab sourcetype="linux:auth" "Failed password"
| rex field=_raw "Failed password for (?:invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| bin _time span=5m
| stats count AS failed_attempts values(username) AS targeted_users BY _time src_ip
| where failed_attempts >= 5
| sort - _time
